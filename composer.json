{
    "name": "mariandumitru/netopay",
    "description": "Laravel package for NETOPIA Payment API integration",
    "keywords": [
        "mariandumitru",
        "laravel",
        "netopay",
        "netopia",
        "payments",
        "payment-gateway",
        "netopia-payments"
    ],
    "homepage": "https://github.com/mariandumitru/netopay",
    "license": "MIT",
    "authors": [
        {
            "name": "Marian Dumitru",
            "email": "marian@marianthedev.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "illuminate/contracts": "^13.0",
        "illuminate/support": "^13.0",
        "spatie/laravel-package-tools": "^1.93"
    },
    "require-dev": {
        "laravel/pint": "^1.29",
        "larastan/larastan": "^3.9",
        "nunomaduro/collision": "^8.9",
        "orchestra/testbench": "^11.0",
        "pestphp/pest": "^4.5",
        "pestphp/pest-plugin-arch": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan-deprecation-rules": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "MarianDumitru\\Netopay\\": "src/",
            "MarianDumitru\\Netopay\\Database\\Factories\\": "database/factories/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MarianDumitru\\Netopay\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "scripts": {
        "post-autoload-dump": "@composer run prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "analyse": "vendor/bin/phpstan analyse",
        "test": "vendor/bin/pest",
        "test-coverage": "vendor/bin/pest --coverage",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "MarianDumitru\\Netopay\\NetopayServiceProvider"
            ],
            "aliases": {
                "Netopay": "MarianDumitru\\Netopay\\Facades\\Netopay"
            }
        }
    }
}
